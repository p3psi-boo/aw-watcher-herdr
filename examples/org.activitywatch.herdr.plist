<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.activitywatch.herdr</string>
  <key>ProgramArguments</key><array>
    <string>/ABSOLUTE/PATH/aw-watcher-herdr</string>
    <string>--herdr</string><string>/ABSOLUTE/PATH/herdr</string>
    <string>--socket</string><string>/ABSOLUTE/PATH/herdr.sock</string>
    <string>--selection-interval</string><string>SELECTION_INTERVAL</string>
    <string>--heartbeat-interval</string><string>HEARTBEAT_INTERVAL</string>
    <string>--pulsetime</string><string>PULSETIME</string>
    <string>--retry-interval</string><string>RETRY_INTERVAL</string>
    <string>--timeout</string><string>REQUEST_TIMEOUT</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/ABSOLUTE/PATH/aw-herdr.stdout.log</string>
  <key>StandardErrorPath</key><string>/ABSOLUTE/PATH/aw-herdr.stderr.log</string>
</dict></plist>
